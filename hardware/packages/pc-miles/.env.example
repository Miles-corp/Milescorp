# MILES — configuration du mini-PC (copier vers .env puis personnaliser)
# chmod 600 .env après copie. NE JAMAIS commiter ce fichier.

# Clé IA (obligatoire)
MILES_API_KEY=

# Fournisseur : remote | local | off
MILES_PROVIDER=off

# Backend box (relevés capteurs ESP32-S3) — clé partagée locale
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MILES_BOX_KEY=

# Interface web (jeton porteur, requis pour --web et --web-lan)
MILES_WEB_AUTH_TOKEN=

# Mode LAN opt-in (fail-closed) : à activer UNIQUEMENT après audit B
# MILES_WEB_LAN=1
# MILES_WEB_LAN_HOST=192.168.1.42
