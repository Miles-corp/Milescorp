# Exemple de variables d'environnement pour MILES — paquet pc-miles (mini-PC Debian 13)
# Copiez ce fichier vers .env puis adaptez les valeurs : cp .env.example .env
# chmod 600 .env — NE JAMAIS commiter de vraies clés API dans ce fichier.
#
# Ce fichier est DÉRIVÉ de `.env.example` à la racine du dépôt : toute variable
# ajoutée là-bas doit être ajoutée ici (garde-fou : tests/test_env_examples.py).

# Fournisseur IA : "remote" ou "local" (aucune autre valeur n'est acceptée)
MILES_PROVIDER=remote

# Configuration fournisseur distant
MILES_REMOTE_BASE_URL=http://localhost:8000
MILES_REMOTE_MODEL=miles-default
MILES_REMOTE_TIMEOUT=30
# MILES_REMOTE_API_KEY=votre_cle_api_ici

# Configuration fournisseur local
MILES_LOCAL_BASE_URL=http://localhost:11434
MILES_LOCAL_MODEL=miles-local
MILES_LOCAL_TIMEOUT=60
# MILES_LOCAL_API_KEY=votre_cle_api_ici

# Historique de conversation (nombre de messages transmis au modèle)
MILES_HISTORY_LIMIT=10

# Voix optionnelle
MILES_VOICE_ENABLED=false

# Mémoire persistante locale
MILES_MEMORY_ENABLED=false
MILES_MEMORY_DB_PATH=data/memory.db
MILES_MEMORY_MAX_MEMORIES_IN_CONTEXT=5
MILES_MEMORY_MAX_CONTENT_LENGTH=1000

# Persistance de l'historique de conversation (V1)
MILES_CONVERSATION_PERSIST=true
MILES_CONVERSATION_DB_PATH=data/conversations.db

# --- Spécifique au paquet pc-miles ---

# Backend boîtier : clé partagée locale, exigée par miles-bridge et le firmware.
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MILES_BOX_KEY=

# Interface web : jeton porteur, affiché une seule fois par `miles.py --setup`.
# Sans jeton configuré, l'interface web refuse toute session (fermé par défaut).
MILES_WEB_AUTH_TOKEN=
