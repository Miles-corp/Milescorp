# MILES — configuration du mini-PC (Debian 13) — paquet pc-miles.
#
# Copier vers .env puis personnaliser :   cp .env.example .env && chmod 600 .env
# NE JAMAIS committer ce fichier.
#
# Ce fichier est DERIVE de .env.example a la racine du depot (source de
# verite) : il en reprend toutes les lignes, plus les variables propres au
# boitier. tests/test_env_example_alignment.py empeche toute derive.
#
# Clé API IA : saisie via `python3 miles.py --setup` (saisie masquee,
# ecriture atomique) — jamais en clair dans ce fichier.

# ---------------------------------------------------------------------
# Fournisseur IA : "remote", "local" ou "off"
# ---------------------------------------------------------------------
MILES_PROVIDER=remote

# ---------------------------------------------------------------------
# Configuration fournisseur distant (API compatible OpenAI)
# ---------------------------------------------------------------------
MILES_REMOTE_BASE_URL=http://localhost:8000
MILES_REMOTE_MODEL=miles-default
MILES_REMOTE_TIMEOUT=30
# MILES_REMOTE_API_KEY=votre_cle_api_ici

# ---------------------------------------------------------------------
# Configuration fournisseur local (ex. Ollama)
# ---------------------------------------------------------------------
MILES_LOCAL_BASE_URL=http://localhost:11434
MILES_LOCAL_MODEL=miles-local
MILES_LOCAL_TIMEOUT=60
# MILES_LOCAL_API_KEY=votre_cle_api_ici

# ---------------------------------------------------------------------
# Historique de conversation (nombre de messages transmis au modèle)
# ---------------------------------------------------------------------
MILES_HISTORY_LIMIT=10

# ---------------------------------------------------------------------
# Voix optionnelle
# ---------------------------------------------------------------------
MILES_VOICE_ENABLED=false

# ---------------------------------------------------------------------
# Mémoire persistante locale (SQLite)
# ---------------------------------------------------------------------
MILES_MEMORY_ENABLED=false
MILES_MEMORY_DB_PATH=data/memory.db
MILES_MEMORY_MAX_MEMORIES_IN_CONTEXT=5
MILES_MEMORY_MAX_CONTENT_LENGTH=1000

# ---------------------------------------------------------------------
# Persistance de l'historique de conversation
# ---------------------------------------------------------------------
MILES_CONVERSATION_PERSIST=true
MILES_CONVERSATION_DB_PATH=data/conversations.db

# ---------------------------------------------------------------------
# Orchestrateur de missions
# ---------------------------------------------------------------------
MILES_MISSION_ENABLED=false
MILES_MISSION_PERSIST=true
MILES_MISSION_DB_PATH=data/missions.db
MILES_MISSION_MAX_STEPS=20
MILES_MISSION_MAX_ATTEMPTS=3
MILES_MISSION_MAX_DURATION_SECONDS=600
MILES_MISSION_MAX_TOOL_CALLS=50
MILES_MISSION_MAX_INTERACTIONS=10

# ---------------------------------------------------------------------
# Interface web (jeton porteur — requis avant tout démarrage web)
# ---------------------------------------------------------------------
MILES_WEB_AUTH_TOKEN=
MILES_WEB_USERS_FILE=
MILES_WEB_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------
# Variables de chemin — lues EXCLUSIVEMENT depuis l'environnement du
# processus, JAMAIS depuis le .env (aucun effet ici) :
#   MILES_ENV_FILE, MILES_CONFIG
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Spécifique boîtier MILES (paquet pc-miles)
# ---------------------------------------------------------------------
# Backend box (relevés capteurs ESP32-S3) — clé partagée locale, générée
# sur la machine : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MILES_BOX_KEY=

# Mode LAN opt-in (fail-closed) : UNIQUEMENT après audit B de l'ouverture.
# Sans MILES_WEB_AUTH_TOKEN configuré, `--web-lan` refuse de démarrer.
# MILES_WEB_LAN=1
# MILES_WEB_LAN_HOST=192.168.1.42
